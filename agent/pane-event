#!/usr/bin/python3
"""pane-remote 用的 hook：把「回合结束 / 需要你操作」连同所选终端后端的 pane ID记到本地，
服务端扫描时经 bridge 的 events 命令读走，用来推送和显示状态。不联网，永远 exit 0。

用法（hook 配置里）：pane-event <stop|notify|failure|permission|prompt|session> [--agent claude|codex]
  session：SessionStart 时调，只记下这个 pane 的会话信息
"""
import json, os, sys, time
from herdr_backend import current_pane, pane_value

LOG = os.path.expanduser("~/.local/state/pane-remote/events.jsonl")
# 每个 pane 当前的 Claude / Codex 会话（会话 ID、记录文件、账号目录），给手机端的「分叉会话」「对话视图」用
PANES = os.path.expanduser("~/.local/state/pane-remote/panes.json")
MAX = 512 * 1024  # 超过就截掉前一半，文件不会无限长


def main():
    kind = sys.argv[1] if len(sys.argv) > 1 else "event"
    agent = sys.argv[sys.argv.index("--agent") + 1] if "--agent" in sys.argv else "claude"
    pane = current_pane()
    if not pane:
        return  # 不在受支持的终端里跑的会话，手机端管不到
    try:
        hook = json.load(sys.stdin)
    except Exception:
        hook = {}
    msg = hook.get("message") or hook.get("last_assistant_message") or ""
    if not isinstance(msg, str):
        msg = ""
    sid = hook.get("session_id") or ""
    if sid:
        try:
            panes = json.load(open(PANES))
        except Exception:
            panes = {}
        panes[pane] = {"agent": agent, "session": sid, "transcript": hook.get("transcript_path") or "",
                       "configDir": os.environ.get("CLAUDE_CONFIG_DIR", ""), "cwd": hook.get("cwd") or os.getcwd(), "t": time.time()}
        os.makedirs(os.path.dirname(PANES), exist_ok=True)
        with open(PANES + ".tmp", "w") as f:
            json.dump(panes, f, ensure_ascii=False)
        os.replace(PANES + ".tmp", PANES)
    if kind == "session":
        return  # 只为记会话信息，不算事件
    rec = {"t": time.time(), "pane": pane_value(pane), "agent": agent, "kind": kind,
           "msg": " ".join(msg.split())[:200], "cwd": hook.get("cwd") or os.getcwd()}
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    try:
        if os.path.getsize(LOG) > MAX:
            # 截掉的字节数记在新文件第一行 {"base": N}：bridge 按「base + 行头之后的位置」报偏移，
            # 偏移只增不减，截断后服务端接着读，不会从头把整个文件重放一遍（重推一串旧通知）
            with open(LOG, "rb") as f:
                head = f.readline()
                try:
                    base, hlen = int(json.loads(head)["base"]), len(head)
                except Exception:
                    base, hlen = 0, 0
                f.seek(-MAX // 2, 2)
                cut = f.tell()
                rest = f.read()
            skip, _, keep = rest.partition(b"\n")
            base += cut + len(skip) + 1 - hlen
            with open(LOG + ".tmp", "wb") as f:
                f.write(json.dumps({"base": base}).encode() + b"\n" + keep)
            os.replace(LOG + ".tmp", LOG)
    except FileNotFoundError:
        pass
    with open(LOG, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


try:
    main()
except Exception:
    pass
sys.exit(0)
