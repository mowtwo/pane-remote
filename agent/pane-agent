TRIAGE_SYS = ("You triage error reports for pane-remote, a phone remote for terminal coding agents. Do not use any tools, do not read files or search: "
              "answer only from the report text. Reply with one JSON object only, no prose, no code fence.")
CHEAP = re.compile(r"mini|nano|lite|luna|small|flash|haiku|low", re.I)


def cheap_codex_model():
    """Codex：从账号的模型缓存里挑一个轻量的（名字带 mini / luna / lite 之类），挑不到就用列表最后一个"""
    try:
        d = json.load(open(os.path.join(HOME, ".codex/models_cache.json")))
        ms = [m for m in (d.get("models", d) if isinstance(d, dict) else d) if isinstance(m, dict) and m.get("visibility", "list") == "list"]
        slugs = [m.get("slug") or m.get("id") for m in ms if m.get("slug") or m.get("id")]
        return next((x for x in slugs if CHEAP.search(x)), slugs[-1] if slugs else "")
    except Exception:
        return ""


def cheap_cursor_model():
    """cursor-agent：从 --list-models 里挑（Composer Fast 优先，其次 flash / mini / low），结果缓存一天"""
    cache = os.path.join(TRIAGE_DIR, "cursor-models.txt")
    try:
        if time.time() - os.path.getmtime(cache) < 86400:
            text = open(cache).read()
        else:
            raise OSError
    except OSError:
        text = subprocess.run(["cursor-agent", "--list-models"], capture_output=True, text=True, timeout=30, env=agent_env()).stdout
        os.makedirs(TRIAGE_DIR, exist_ok=True)
        open(cache, "w").write(text)
    ids = [l.split(" - ")[0].strip() for l in text.splitlines() if " - " in l]
    return next((x for x in ids if re.search(r"composer.*fast", x)), next((x for x in ids if CHEAP.search(x)), "auto"))


# 经 ssh 调用时 macOS 钥匙串是锁着的：Claude Code、cursor-agent 存在钥匙串里的登录读不到。
# 要用它们做 AI 分类，就把长期令牌放进这个文件（pane-agent triage-token 写，权限 600）：
#   CLAUDE_CODE_OAUTH_TOKEN=…（claude setup-token 生成）  CURSOR_API_KEY=…（Cursor 后台生成）
# Codex 的登录在 ~/.codex/auth.json，经 ssh 也能用，不需要这个
TRIAGE_ENV = os.path.join(HOME, ".config/pane-remote/triage-env")
TRIAGE_KEYS = ("CLAUDE_CODE_OAUTH_TOKEN", "CURSOR_API_KEY")


def triage_tokens():
    out = {}
    try:
        for line in open(TRIAGE_ENV):
            k, _, v = line.strip().partition("=")
            if k in TRIAGE_KEYS and v:
                out[k] = v
    except OSError:
        pass
    return out


def agent_env():
    path = os.pathsep.join([os.path.join(HOME, ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"])
    env = {k: v for k, v in os.environ.items() if not k.startswith(("CLAUDE_CODE_", "CLAUDECODE", "WEZTERM_PANE", "HERDR_", "PANE_REMOTE_INCIDENT"))}
    return {**env, "PATH": path, **triage_tokens()}


def save_triage_token(kind):
    """pane-agent triage-token claude|cursor：从键盘读一个令牌（不回显、不打印），写进 triage-env（600）"""
    import getpass
    key = {"claude": "CLAUDE_CODE_OAUTH_TOKEN", "cursor": "CURSOR_API_KEY"}.get(kind)
    if not key:
        sys.exit("usage: pane-agent triage-token claude|cursor")
    tok = getpass.getpass(f"粘贴 {key}（不会显示）：").strip()
    if not re.fullmatch(r"[A-Za-z0-9_\-.]{20,400}", tok):
        sys.exit("看起来不像令牌，没保存")
    cur = triage_tokens()
    cur[key] = tok
    os.makedirs(os.path.dirname(TRIAGE_ENV), exist_ok=True)
    fd = os.open(TRIAGE_ENV + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("".join(f"{k}={v}\n" for k, v in cur.items()))
    os.replace(TRIAGE_ENV + ".tmp", TRIAGE_ENV)
    print(f"已保存到 {TRIAGE_ENV}（只有你能读）")


def triage(req):
    """req: {agent, wrapper?, model?, prompt}。返回 {ok, result(JSON), agent, model, ms, err}"""
    agent = req.get("agent") if req.get("agent") in AGENTS else "claude"
    prompt = str(req.get("prompt", ""))[:12000]
    model = str(req.get("model") or "")
    if model and not re.fullmatch(r"[\w.:-]{1,60}", model):
        return {"ok": False, "err": "bad model"}
    os.makedirs(TRIAGE_DIR, exist_ok=True)
    out_file = os.path.join(TRIAGE_DIR, f"out-{os.getpid()}.txt")
    if agent == "claude":
        wrapper = req.get("wrapper") or "claude"
        if not WRAPPER_RE.fullmatch(wrapper):
            return {"ok": False, "err": "bad wrapper"}
        env_part, _, exe = wrapper.rpartition(" ")
        model = model or "haiku"
        cmd = [exe, "-p", "--model", model, "--system-prompt", TRIAGE_SYS, "--setting-sources", "project", "--strict-mcp-config", "--tools", "",
               "--no-session-persistence", "--permission-mode", "default", "--output-format", "json", prompt]
        extra_env = dict(kv.split("=", 1) for kv in env_part.split() if "=" in kv) if env_part else {}
        extra_env = {k: os.path.expandvars(v.strip('"')) for k, v in extra_env.items()}
    elif agent == "codex":
        model = model or cheap_codex_model()
        cmd = ["codex", "exec", "--ephemeral", "--skip-git-repo-check", "-s", "read-only", "--disable", "hooks", "-c", "mcp_servers={}",
               *(["-m", model] if model else []), "-c", "model_reasoning_effort=low", "-o", out_file, f"{TRIAGE_SYS}\n\n{prompt}"]
        extra_env = {}
    else:
        model = model or cheap_cursor_model()
        cmd = ["cursor-agent", "-p", "--trust", "--mode", "ask", "--model", model, "--output-format", "text", f"{TRIAGE_SYS}\n\n{prompt}"]
        extra_env = {}
    t0 = time.time()
    try:
        r = subprocess.run(cmd, cwd=TRIAGE_DIR, capture_output=True, text=True, timeout=100, env={**agent_env(), **extra_env}, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return {"ok": False, "err": "timeout", "agent": agent, "model": model}
    ms = int((time.time() - t0) * 1000)
    text = r.stdout
    if agent == "claude":
        try:
            d = json.loads(text)
            if d.get("is_error"):
                msg = str(d.get("result"))[:300]
                return {"ok": False, "err": msg, "auth": bool(re.search(r"Not logged in|/login|keychain|token", msg, re.I)), "agent": agent, "model": model, "ms": ms}
            text = d.get("result") or ""
        except ValueError:
            pass
    elif agent == "codex":
        try:
            text = open(out_file).read()
        except OSError:
            text = ""
        finally:
            try:
                os.unlink(out_file)
            except OSError:
                pass
    m = re.search(r"\{.*\}", text, re.S)
    try:
        result = json.loads(m.group(0)) if m else None
    except ValueError:
        result = None
    if not isinstance(result, dict):
        raw = re.sub(r"\x1b\[[0-9;]*m", "", text or r.stderr or "no output")[-300:]
        auth = bool(re.search(r"Not logged in|keychain is locked|/login|API key|authenticat|unauthori", raw, re.I))
        return {"ok": False, "err": raw, "auth": auth, "agent": agent, "model": model, "ms": ms}
    return {"ok": True, "result": result, "agent": agent, "model": model, "ms": ms}


