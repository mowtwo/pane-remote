            if f and os.path.isfile(f):
                st = os.stat(f)
                stamp.append(f"{st.st_size}.{st.st_mtime_ns}")
        key = f"{path}:{'/'.join(stamp)}"
        if known and known == key:
            print(json.dumps({"key": key, "unchanged": True}))
        else:
            print(json.dumps({"key": key, "messages": messages(pane, min(n, 200))}, ensure_ascii=False))
